--- !u!114 &348277818
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 348277817}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2161ac56358011c19360ee091aa42f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues
  dialogues:
  - DialogueID: 0
    dialogueText: Mama gracias por tanto en mi vida, espero hoy nos visites una vez
      mas.
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 1
    dialogueText: '. . . . . '
    TalkingCharacter: 1
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 2
    dialogueText: No te preocupes hija, no tiene nada de malo no saber que decir
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 3
    dialogueText: Tu paleta abuela
    TalkingCharacter: 1
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 4
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 2
  - DialogueID: 5
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 6
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 1
  - DialogueID: 7
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 2
  - DialogueID: 8
    dialogueText: Lista para poner el altar hija?
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 2
  - DialogueID: 9
    dialogueText: Si mama
    TalkingCharacter: 1
    CameraPosition: 1
    timeOfDay: 2
  - DialogueID: 10
    dialogueText: 'Madre, un dia mas en el cual esperamos con ansias tu visita, Regina
      ya es doctora '
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 11
    dialogueText: 'Han sido fechas pesadas abuela, pero todos me han apoyado, '
    TalkingCharacter: 1
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 12
    dialogueText: Bueno, andale hija pon su paleta
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 13
    dialogueText: . . . . .
    TalkingCharacter: 1
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 14
    dialogueText: Mama. . . .
    TalkingCharacter: 1
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 15
    dialogueText: Aprovecho y tambien te digo a ti abuela, estoy embarazada. . .
    TalkingCharacter: 1
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 16
    dialogueText: Hija, felicidades, ay que emocion, madre escuchaste eso? Ay mi
      hija que felicidad
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 17
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 18
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 1
  - DialogueID: 19
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 2
  - DialogueID: 20
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 21
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 22
    dialogueText: Abuela . . . .
    TalkingCharacter: 1
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 23
    dialogueText: Ma- Mami. . . .
    TalkingCharacter: 2
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 24
    dialogueText: Que paso hermosa?
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 25
    dialogueText: '* Snif, snif *'
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 26
    dialogueText: Andale, Lara, pon el pastelito, a tu abuela le encataban esos
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 27
    dialogueText: Ten abuela, tu paleta. . . .
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 28
    dialogueText: Espero que despues de tan-     tantos a;os. . . . . . puedan psar
      tiempo juntas
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 29
    dialogueText: '* Snif, snif *'
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 29
    dialogueText: Larita, te deje pan de muerto en la cocina, por que no vas y te
      srives tambien un poco de leche, vas a ver te va a gustar
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 29
    dialogueText: SI!
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 32
    dialogueText: . . . . . No- no se que hacer mama, solo tiene 6, por- por que
      a ella?
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 33
    dialogueText: El trabajo, los pacientes, medicamentos, me estoy cansado mama
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 34
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 35
    dialogueText: Hija, alistate para la escuela
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 36
    dialogueText: Si mama voy
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 37
    dialogueText: Lara, segura de ir hoy?
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 38
    dialogueText: Si mama, no te preocupes
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 39
    dialogueText: No vayas hoy ok cari;o?
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 1
  - DialogueID: 40
    dialogueText: '. . . . '
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 41
    dialogueText: Lara! Vas tarde
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 42
    dialogueText: Lara!
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 43
    dialogueText: La- Lara. . .
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 0
  - DialogueID: 44
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 1
    timeOfDay: 2
  - DialogueID: 45
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 46
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 47
    dialogueText: 
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
  - DialogueID: 48
    dialogueText: Mama, abuela, porfavor cuiden de mi larita, si?
    TalkingCharacter: 0
    CameraPosition: 0
    timeOfDay: 2
