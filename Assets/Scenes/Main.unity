  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues
  dialogues:
  - DialogueID: 0
    dialogueText: 
    TalkingCharacter: 0
    characterStage: 0
    CameraPosition: 0
    timeOfDay: 2
    hideObjects:
    - {fileID: 183146619}
    showObjects:
    - {fileID: 2083066965}
  - DialogueID: 1
    dialogueText: 'Expreso agradecimiento a su madre por toda su infancia  '
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    hideObjects:
    - {fileID: 183146619}
    showObjects:
    - {fileID: 2083066965}
  - DialogueID: 2
    dialogueText: "y espera que la visite en el D\xEDa de Muertos,"
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    hideObjects:
    - {fileID: 183146619}
    showObjects:
    - {fileID: 2083066965}
  - DialogueID: 3
    dialogueText: "menciona como ese d\xEDa en la playa fue el d\xEDa favorito de
      su madre"
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    hideObjects:
    - {fileID: 183146619}
    showObjects:
    - {fileID: 2083066965}
  - DialogueID: 4
    dialogueText: '. . . '
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 0
    timeOfDay: 2
    hideObjects:
    - {fileID: 183146619}
    showObjects:
    - {fileID: 2083066965}
  - DialogueID: 5
    dialogueText: (se rie) Le dice a su hija que no se preocupe
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    hideObjects:
    - {fileID: 183146619}
    showObjects:
    - {fileID: 2083066965}
  - DialogueID: 6
    dialogueText: " no tiene nada de malo no saber qu\xE9 decir."
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    hideObjects:
    - {fileID: 183146619}
    showObjects:
    - {fileID: 2083066965}
  - DialogueID: 7
    dialogueText: "Aqu\xED tienes abuela"
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 0
    timeOfDay: 2
    hideObjects: []
    showObjects:
    - {fileID: 2083066965}
    - {fileID: 183146619}
