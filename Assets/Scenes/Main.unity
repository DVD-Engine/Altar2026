--- !u!114 &348277818
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 348277817}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2161ac56358011c19360ee091aa42f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues
  dialogues:
  - DialogueID: 0
    dialogueText: 
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 1
    dialogueText: "Mam\xE1, \xBFC\xF3mo estas? \xBFQu\xE9 tal te ha ido? "
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 8300000, guid: fedaa4e22f5307370ac5cb2996cde993, type: 3}
    radioVolume: 0.015
    radioOff: 0
  - DialogueID: 2
    dialogueText: "Espero que este d\xEDa nos puedas visitar. Regi te extra\xF1a
      mucho"
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 3
    dialogueText: "A\xFAn se acuerda mucho de aquel d\xEDa que est\xE1bamos todos
      en la playa"
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 4
    dialogueText: '. . . '
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 5
    dialogueText: No pasa nada, hija
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 6
    dialogueText: "No tiene nada de malo no saber qu\xE9 decir"
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 7
    dialogueText: "Pon su paleta, \xE1ndale"
    TalkingCharacter: 0
    characterStage: 3
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 8
    dialogueText: "Aqu\xED tienes, abuela"
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    - {fileID: 439035772}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 9
    dialogueText: 
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083066965}
    - {fileID: 439035772}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 10
    dialogueText: 
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 1
    timeOfDay: 0
    showObjects:
    - {fileID: 1397424711}
    radioClip: {fileID: 8300000, guid: 565ec7bee2a8639e6bafaf6350331122, type: 3}
    radioVolume: 0.06
    radioOff: 0
  - DialogueID: 11
    dialogueText: 
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 1
    timeOfDay: 1
    showObjects:
    - {fileID: 1392922198}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 12
    dialogueText: 
    TalkingCharacter: 1
    characterStage: 0
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 6733492947391615023}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 13
    dialogueText: "\xBFD\xEDa largo hoy, hija?"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 6733492947391615023}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 14
    dialogueText: "S\xED, un poco, feliz de ya estar en casa"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 6733492947391615023}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 15
    dialogueText: "Vamos a poner el altar, \xE1ndale"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 6733492947391615023}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 16
    dialogueText: "Ve pas\xE1ndome las cosas, hija"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 578924300}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 17
    dialogueText: "\xBFQu\xE9 tal ahora en el hospital?"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083460407}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 18
    dialogueText: Bien, pesado, muchos pacientes, no nos damos abasto
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 2083460407}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 19
    dialogueText: Pero me agrada estar ahi
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 94820728}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 20
    dialogueText: "Qu\xE9 bueno, hija, con mi edad yo creo que pronto te estar\xE9
      visitando"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 94820728}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 21
    dialogueText: "Mam\xE1. . . no digas eso"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 1305448907}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 22
    dialogueText: "\xBFQu\xE9 tiene, hija? As\xED son las cosas"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 1305448907}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 23
    dialogueText: "\xC1ndale, pon la paleta de tu abuela"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 1305448907}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 24
    dialogueText: . . . .
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 64591468}
    - {fileID: 1305448907}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 25
    dialogueText: "Mam\xE1, no s\xE9 si sea buen momento"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 1305448907}
    - {fileID: 64591468}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 26
    dialogueText: "Estoy embarazada, hace un par de d\xEDas nos dieron los resultados"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 1305448907}
    - {fileID: 64591468}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 27
    dialogueText: "\xA1Ay, hija, qu\xE9 hermosa noticia!"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 1305448907}
    - {fileID: 64591468}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 28
    dialogueText: "Mam\xE1, vas a ser abuela, \xA1ay, qu\xE9 emoci\xF3n!"
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 1305448907}
    - {fileID: 64591468}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 29
    dialogueText: 
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 1
    timeOfDay: 0
    showObjects:
    - {fileID: 1257748450}
    radioClip: {fileID: 8300000, guid: 5cba16b1df17296a986ac654d9621337, type: 3}
    radioVolume: 0.07
    radioOff: 0
  - DialogueID: 30
    dialogueText: 
    TalkingCharacter: 0
    characterStage: 4
    CameraPosition: 1
    timeOfDay: 1
    showObjects:
    - {fileID: 609994621}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 31
    dialogueText: "Pasa, hija, \xE1ndale"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 1869600429}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 32
    dialogueText: "No quiero, mam\xE1 . . . no quiero"
    TalkingCharacter: 2
    characterStage: 6
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 1869600429}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 33
    dialogueText: "Larita, si no hacemos el altar, \xBFc\xF3mo nos visitar\xE1 la
      abuela?"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 1869600429}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 34
    dialogueText: No quiero hacerlo sin ella
    TalkingCharacter: 2
    characterStage: 6
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 1869600429}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 35
    dialogueText: . . . . . .
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 1869600429}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 36
    dialogueText: Te quiero mucho, hermosa
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 1869600429}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 37
    dialogueText: Venga, vamos a hacerlo
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 1
    timeOfDay: 2
    showObjects:
    - {fileID: 1869600429}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 38
    dialogueText: "Perd\xF3n, hija, que no hemos podido estar aqu\xED contigo"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 39
    dialogueText: Hemos estado muy ocupados en el hospital
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 40
    dialogueText: "O que no . . . podamos darte toda nuestra atenci\xF3n"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 41
    dialogueText: ". . . \xBFC\xF3mo te has sentido?"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 42
    dialogueText: 'Bien. . . '
    TalkingCharacter: 2
    characterStage: 6
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 43
    dialogueText: "Poco a poco, \xBFok, hermosa?"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 44
    dialogueText: "Te prometo que ya mejorar\xE1s pronto, hermosa"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 45
    dialogueText: "\xC1ndale, pon la rebanada de pastel para tu abuela"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 46
    dialogueText: ". . . S\xED"
    TalkingCharacter: 2
    characterStage: 6
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 47
    dialogueText: Y la paleta para mi abuela
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    - {fileID: 1342424229}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 48
    dialogueText: "\xC1ndale, ve a la cocina, ah\xED est\xE1 tu pan de muerto"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    - {fileID: 1342424229}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 49
    dialogueText: "S\xED, s\xED, s\xED, voy"
    TalkingCharacter: 2
    characterStage: 6
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    - {fileID: 1342424229}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 50
    dialogueText: . . . .
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    - {fileID: 1342424229}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 51
    dialogueText: "Mam\xE1, ay\xFAdame, no s\xE9 qu\xE9 hacer"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    - {fileID: 1342424229}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 52
    dialogueText: Ya lleva 2 semanas sin su medicamento
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    - {fileID: 1342424229}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 53
    dialogueText: No puedo hacer nada, trabajo en el hospital y no puedo hacer nada
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
    - {fileID: 281412582}
    - {fileID: 1072448269}
    - {fileID: 1342424229}
    radioClip: {fileID: 0}
    radioVolume: 0
    radioOff: 0
  - DialogueID: 54
    dialogueText: "Solo espero que esto se resuelva pronto, no puede pasar m\xE1s
      tiempo as\xED"
    TalkingCharacter: 1
    characterStage: 2
    CameraPosition: 0
    timeOfDay: 2
    showObjects:
